<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="HabitManager.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:HabitManager.Maui"
    xmlns:views="clr-namespace:HabitManager.Maui.Views"
    Title="HabitManager.Maui">

    <TabBar>  <!-- saģenerēja MI -->
        <Tab Title="Uncompleted">
            <ShellContent ContentTemplate="{DataTemplate views:UncompletedHabitListPage}" />
        </Tab>

        <Tab Title="Completed Today">
            <ShellContent ContentTemplate="{DataTemplate views:CompletedHabitListPage}" />
        </Tab>

        <Tab Title="Archived">
            <ShellContent ContentTemplate="{DataTemplate views:ArchivedHabitListPage}" />
        </Tab>
    </TabBar>
</Shell>
