<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HabitManager.Maui.Views.ArchivedHabitListPage"
             x:Name="ArchivedPage"
             Title="Habits"
             xmlns:converters="clr-namespace:HabitManager.Maui.Converters">
    <ContentPage.Resources>
        <converters:PeriodicityConverter x:Key="PeriodicityConverter" />
        <converters:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter" />
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto, *" Padding="10">
        <CollectionView Grid.Row="1" ItemsSource="{Binding Habits}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="LightGray" CornerRadius="5" Padding="10" Margin="5">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding Description}" TextColor="Gray" IsVisible="{Binding Description, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                            <Label Text="{Binding Periodicity, Converter={StaticResource PeriodicityConverter}}" />
                            <Label Text="{Binding Status}" />
                            <Label Text="{Binding UpdatedAt, StringFormat='Updated At: {0:dd.MM.yyyy}'}" FontSize="12" />

                            <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,5,0,0">
                                <Button Grid.Column="0" Text="Back from Archive" Command="{Binding Source={x:Reference ArchivedPage}, Path=BindingContext.ToggleHabitStatusCommand}" CommandParameter="{Binding .}" />
                                <Button Grid.Column="1" Text="Show Details" Command="{Binding Source={x:Reference ArchivedPage}, Path=BindingContext.ShowHabitDetailsCommand}" CommandParameter="{Binding .}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>